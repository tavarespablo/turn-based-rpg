pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

-- ヌ⬆️🐱         constants           ヌ⬆️🐱

local ATB_MAX        = 100
local ATB_BAR_START  = 40   -- player atb bar left edge (px)
local ATB_BAR_END    = 76   -- player atb bar right edge (px)
local MON_ATB_START  = 51   -- monster atb bar left edge (px)
local MON_ATB_END    = 67   -- monster atb bar right edge (px)
local PLAYER_DAMAGE  = 10
local MONSTER_DAMAGE = 5
local ITEM_HEAL      = 10
local FLASH_DURATION = 15  -- frames (~2s a 60fps)
local FLASH_PERIOD   = 3    -- frames por ciclo de piscar

-- ヌ⬆️🐱           init              ヌ⬆️🐱

function _init()
    init_state()
    init_player()
    init_monster()
    init_menu()
end

function init_state()
    game_over       = false
    player_won      = false
    your_turn       = false
    monster_turn    = false
    in_item_menu    = false
    player_flash_t  = 0
    monster_flash_t = 0
    music(0)
end

function init_player()
    player_health      = 100
    player_max_health  = 100
    player_defending   = false
    player_atb         = 0
    player_atb_fill    = ATB_BAR_START
    player_y_offset    = 0
    player_co          = nil
    player_attacking   = false
end

function init_monster()
    monster_health     = 100
    monster_max_health = 100
    monster_atb        = 0
    monster_atb_fill   = MON_ATB_START
    monster_y_offset   = 0
    monster_co         = nil
end

function init_menu()
    actions  = {"attack", "defend", "item", "run"}
    items    = {"potion", "back"}   -- "back" deve ser sempre o れむltimo
    menusel  = 1
    itemsel  = 1
end

-- ヌ⬆️🐱          update             ヌ⬆️🐱

function _update()
    if game_over or player_won then
        if btnp(4) then _init() end
        return
    end

    update_flash_timers()
    update_player_attack_anim()
    update_player_atb()
    update_monster_atb()
    update_menu()
end

function update_flash_timers()
    if player_flash_t  > 0 then player_flash_t  -= 1 end
    if monster_flash_t > 0 then monster_flash_t -= 1 end
end

function update_player_attack_anim()
    if not player_attacking then return end

    if costatus(player_co) != "dead" then
        coresume(player_co)
        return
    end

    -- animation done: apply damage
    sfx(0)
    monster_health -= PLAYER_DAMAGE
    monster_flash_t = FLASH_DURATION
    if monster_health <= 0 then
        monster_health = 0
        player_won     = true
    end

    player_attacking = false
    player_y_offset  = 0
    your_turn        = false
    player_atb       = 0
    player_atb_fill  = ATB_BAR_START
end

function player_attack_anim()
    -- move up toward monster (negative y = up in pico-8)
    for i = 1, 5 do
        player_y_offset -= 3
        yield()
    end
    for i = 1, 5 do
        player_y_offset += 3
        yield()
    end
end

function update_player_atb()
    if your_turn or player_attacking then return end

    player_atb      += 1
    player_atb_fill  = ATB_BAR_START + (ATB_BAR_END - ATB_BAR_START) * player_atb / ATB_MAX

    if player_atb >= ATB_MAX then
        your_turn       = true
        player_atb      = ATB_MAX
        player_atb_fill = ATB_BAR_END
    end
end

function update_monster_atb()
    if monster_health <= 0 then return end

    -- waiting for animation to finish
    if monster_turn then
        if costatus(monster_co) != "dead" then
            coresume(monster_co)
            return
        end
        -- animation done: deal damage, reset turn
        local dmg = monster_turn_damage()
        sfx(1)
        player_health -= dmg
        player_flash_t = FLASH_DURATION
        if player_health <= 0 then
            player_health = 0
            game_over     = true
        end
        monster_turn     = false
        monster_y_offset = 0
        monster_atb      = 0
        monster_atb_fill = MON_ATB_START
        return
    end

    monster_atb      += 1
    monster_atb_fill  = MON_ATB_START + (MON_ATB_END - MON_ATB_START) * monster_atb / ATB_MAX

    if monster_atb >= ATB_MAX then
        monster_turn     = true
        monster_atb      = ATB_MAX
        monster_atb_fill = MON_ATB_END
        monster_co       = cocreate(monster_attack_anim)
    end
end

function monster_turn_damage()
    if player_defending then
        player_defending = false
        return flr(MONSTER_DAMAGE / 2)
    end
    return MONSTER_DAMAGE
end

function monster_attack_anim()
    for i = 1, 5 do
        monster_y_offset += 2
        yield()
    end
end

function update_menu()
    if not your_turn then return end

    if in_item_menu then
        update_item_menu()
        return
    end

    -- navigate main menu
    if btnp(3) then
        menusel = menusel < #actions and menusel + 1 or 1
    elseif btnp(2) then
        menusel = menusel > 1 and menusel - 1 or #actions
    end

    if btnp(4) then
        if menusel == 3 then   -- item ヌ●★ abre submenu
            in_item_menu = true
            itemsel      = 1
        else
            perform_action()
        end
    end
end

function update_item_menu()
    if btnp(3) then
        itemsel = itemsel < #items and itemsel + 1 or 1
    elseif btnp(2) then
        itemsel = itemsel > 1 and itemsel - 1 or #items
    end

    if btnp(4) then
        local chosen = items[itemsel]
        if chosen == "back" then
            in_item_menu = false
        else
            use_item(chosen)
            in_item_menu = false
            your_turn    = false
            player_atb   = 0
            player_atb_fill = ATB_BAR_START
        end
    end
end

function use_item(name)
    if name == "potion" then
        player_health = min(player_health + ITEM_HEAL, player_max_health)
    end
    -- adiciona novos items aqui no futuro
end

function perform_action()
    if menusel == 1 then        -- attack: lanれせa animaれせれこo (dano aplicado ao fim da corrotina)
        player_attacking = true
        player_co        = cocreate(player_attack_anim)
        return                  -- nれこo encerra o turno aqui; update_player_attack_anim faz isso

    elseif menusel == 2 then    -- defend
        player_defending = true

    elseif menusel == 4 then    -- run
        game_over = true
    end

    -- encerra turno para todas as aれせれふes exceto attack
    your_turn       = false
    player_atb      = 0
    player_atb_fill = ATB_BAR_START
end

-- ヌ⬆️🐱           draw              ヌ⬆️🐱

function _draw()
    cls()
    draw_background()
    draw_battle_scene()
    draw_hud()
end

function draw_background()
    -- cれたu/teto do corredor (preto quase puro)
    rectfill(0, 0, 127, 89, 0)

    -- ponto de fuga: x=64, y=40 (centro do espaれせo de batalha)
    local vx, vy = 64, 40

    -- paredes exteriores (trapれたzio escuro)
    -- parede esquerda
    line(0,  0,  vx, vy, 5)   -- cor 5 = cinza escuro
    line(0, 89,  vx, vy, 5)
    -- parede direita
    line(127,  0, vx, vy, 5)
    line(127, 89, vx, vy, 5)

    -- corredor interior (mais claro, ilusれこo de profundidade)
    local cx1, cy1 = 30, 0    -- canto esquerdo do corredor
    local cx2, cy2 = 98, 0    -- canto direito do corredor
    local cx3, cy3 = 30, 89   -- canto esquerdo baixo
    local cx4, cy4 = 98, 89   -- canto direito baixo

    -- linhas de perspetiva do corredor
    line(cx1, cy1, vx, vy, 1)  -- 1 = cinza mais claro
    line(cx2, cy2, vx, vy, 1)
    line(cx3, cy3, vx, vy, 1)
    line(cx4, cy4, vx, vy, 1)

    -- porta ao fundo (oval + retれけngulo)
    local px, py = vx, vy + 8
    oval(px-8, py-10, px+8, py+2, 1)
    rectfill(px-8, py-2, px+8, py+10, 0)

    -- tochas (simples: rect + pixel laranja)
    -- esquerda
    rectfill(18, 28, 20, 34, 4)  -- cabo (cor castanha)
    pset(19, 26, 9)              -- chama (laranja)
    pset(19, 25, 10)             -- ponta (amarelo)
    -- direita
    rectfill(107, 28, 109, 34, 4)
    pset(108, 26, 9)
    pset(108, 25, 10)
end

function draw_battle_scene()
    -- monster
    spr(129, 56, 38 + monster_y_offset, 4, 4)
    -- player (y_offset negativo = move para cima, em direれせれこo ao monstro)
    spr(64, 44, 54 + player_y_offset, 4, 4)
end

function draw_hud()
    if player_won then
        print("victory!", 43, 50, 10)
        print("press x to play again", 10, 60, 7)
        return
    end
    if game_over then
        print("game over", 42, 50, 8)
        print("press x to play again", 10, 60, 7)
        return
    end

    -- hud panel background
    rectfill(0, 90, 127, 127, 6)
    rectfill(2, 92, 125, 125, 1)

    -- hp text (top-left corner)
    print(player_health .. "/" .. player_max_health, 10, 10, 7)

    -- player hp bar (pisca branco quando flash ativo)
    local p_col = flash_color(player_flash_t, 8)
    draw_bar(43, 100, 83, 106, player_health, player_max_health, p_col)

    -- player atb bar
    rect(43, 108, 83, 114, 6)
    rectfill(44, 109, 6 + player_atb_fill, 113, 10)

    -- monster hp bar (pisca branco quando flash ativo)
    local m_col = flash_color(monster_flash_t, 8)
    draw_bar(52, 19, 75, 23, monster_health, monster_max_health, m_col)

    -- monster atb bar
    rect(52, 23, 75, 27, 6)
    rectfill(53, 24, 7 + monster_atb_fill, 26, 10)

    -- menus
    if your_turn then
        if in_item_menu then
            draw_item_menu()
        else
            draw_action_menu()
        end
    end
end

function draw_action_menu()
    rectfill(5, 88 + 7 * menusel, 29, 94 + 7 * menusel, 5)
    for i = 1, #actions do
        print(actions[i], 6, 89 + 7 * i, 7)
    end
end

function draw_item_menu()
    rectfill(5, 88 + 7 * itemsel, 29, 94 + 7 * itemsel, 5)
    for i = 1, #items do
        print(items[i], 6, 89 + 7 * i, 7)
    end
end

-- retorna branco (7) nos frames "on" do piscar, cor normal nos frames "off"
function flash_color(timer, normal_col)
    if timer > 0 and timer % FLASH_PERIOD < flr(FLASH_PERIOD / 2) then
        return 7   -- branco
    end
    return normal_col
end

-- draws a filled progress bar inside a bordered rect
function draw_bar(x0, y0, x1, y1, val, max_val, col)
    rect(x0, y0, x1, y1, 6)
    local w    = x1 - x0 - 1
    local fill = flr(w * max(0, min(val, max_val)) / max_val)
    if fill > 0 then
        rectfill(x0 + 1, y0 + 1, x0 + fill, y1 - 1, col)
    end
end

